  "info": {
    "title": "Addis Eats API",
    "description": "Food delivery API for Addis Ababa. Monetary amounts are represented in santim, and phone numbers use TeleBirr format.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "restaurants",
      "description": "Restaurant resources"
    },
    {
      "name": "dishes",
      "description": "Menu and dish resources"
    },
    {
      "name": "orders",
      "description": "Customer order resources"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "OrderDishResponseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "priceSantim": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "priceSantim"
        ]
      },
      "OrderResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "customerName": {
            "type": "string"
          },
          "area": {
            "type": "string",
            "enum": [
              "Bole",
              "Kazanchis",
              "Piassa",
              "Megenagna"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "preparing",
              "on_the_way",
              "delivered"
            ]
          },
          "dishes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderDishResponseDto"
            }
          },
          "telebirrPhone": {
            "type": "string"
          },
          "totalSantim": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "customerName",
          "area",
          "status",
          "dishes",
          "totalSantim"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {}
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {}
      },
      "RestaurantResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "area": {
            "type": "string",
            "enum": [
              "Bole",
              "Kazanchis",
              "Piassa",
              "Megenagna"
            ]
          },
          "isOpen": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "area",
          "isOpen"
        ]
      },
      "DishResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "restaurantId": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "priceSantim": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "restaurantId",
          "name",
          "priceSantim"
        ]
      },
      "CreateRestaurantDto": {
        "type": "object",
        "properties": {}
      },
      "CreateDishDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}